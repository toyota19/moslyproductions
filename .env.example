# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Required password to authenticate Admin Panel and Door Scanner sessions.
ADMIN_PASSWORD=""

# QR_SECRET_KEY: High-entropy secret used to sign and verify HMAC-SHA256 QR payloads and HTTP-Only sessions.
QR_SECRET_KEY=""

# RESEND_API_KEY: API key from Resend for automated email delivery of QR passes.
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Verified sender email address for ticket delivery.
RESEND_FROM_EMAIL="MOSLY <entradas@moslyproductions.com>"
